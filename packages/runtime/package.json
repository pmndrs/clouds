{
  "name": "@clouds/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./generate": {
      "types": "./dist/types/src/generate/index.d.ts",
      "import": "./dist/generate.js",
      "default": "./dist/generate.js"
    },
    "./import": {
      "types": "./dist/types/src/import/index.d.ts",
      "import": "./dist/import.js",
      "default": "./dist/import.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "vendor/vdb-web-tools/LICENSE",
    "vendor/vdb-web-tools/NOTICE",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@pmndrs/vdb": "link:../../../WebVDB/packages/vdb"
  },
  "peerDependencies": {
    "@webgpu/types": ">=0.1.60"
  },
  "peerDependenciesMeta": {
    "@webgpu/types": {
      "optional": true
    }
  },
  "typesVersions": {
    "*": {
      "generate": [
        "./dist/types/src/generate/index.d.ts"
      ],
      "import": [
        "./dist/types/src/import/index.d.ts"
      ]
    }
  }
}
