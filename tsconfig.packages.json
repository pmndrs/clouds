{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "rootDir": "packages",
    "outDir": "artifacts/package-types"
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx"],
  "exclude": ["packages/**/*.test.ts", "packages/**/dist", "packages/**/node_modules"]
}
