{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "@webgpu/types",
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@clouds/runtime": [
        "packages/runtime/src/index.ts"
      ],
      "@clouds/core": [
        "packages/core/src/index.ts"
      ],
      "@clouds/legacy-three": [
        "packages/legacy/three/src/index.ts"
      ],
      "@clouds/legacy-react": [
        "packages/legacy/react/src/index.ts"
      ],
      "@clouds/assets": [
        "packages/assets/src/index.ts"
      ],
      "@clouds/tools": [
        "packages/tools/src/index.ts"
      ],
      "@clouds/legacy-three/layers": [
        "packages/legacy/three/src/layers/index.ts"
      ],
      "@clouds/legacy-three/environment": [
        "packages/legacy/three/src/environment/index.ts"
      ],
      "@clouds/legacy-react/layers": [
        "packages/legacy/react/src/layers.tsx"
      ],
      "@clouds/three": [
        "packages/three/src/index.ts"
      ],
      "@clouds/react": [
        "packages/react/src/index.tsx"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "packages/**/*.ts",
    "examples/**/*.ts",
    "bench/**/*.ts",
    "experiments/**/*.ts",
    "fixtures/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "packages/**/*.tsx",
    "examples/**/*.tsx"
  ],
  "exclude": [
    "packages/**/dist",
    "node_modules",
    "dist",
    "artifacts"
  ]
}
