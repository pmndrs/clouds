{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@clouds/core": ["packages/core/src/index.ts"],
      "@clouds/three": ["packages/three/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "examples/**/*.ts", "bench/**/*.ts", "vite.config.ts", "vitest.config.ts"]
}
