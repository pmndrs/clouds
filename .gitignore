# P0.3 linear captures: float frames and raw screenshots stay local (commit only JSON, markdown, small JPEG sheets)
work/captures/P0-3b/**/*.pfm
work/captures/P0-3b/**/*.png

# P0.4 scene card: float frames and raw screenshots stay local (commit JSON, markdown, small JPEG sheets)
work/captures/card/**/*.pfm
work/captures/card/**/*.png
# P0.6: float frames, grids and Cycles EXRs stay local
work/captures/P0-6/**/*.pfm
work/captures/P0-6/**/*.png
work/captures/P0-6/**/*.f32
work/captures/P0-6/**/*.exr
# P1.1: float frames, grids, probes and Cycles EXRs stay local
work/captures/P1-1/**/*.pfm
work/captures/P1-1/**/*.png
work/captures/P1-1/**/*.f32
work/captures/P1-1/**/*.exr
work/captures/P1-1/**/*.npz
work/captures/P1-1/**/probe-*.json
